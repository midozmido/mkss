# انسخ الملف ده لـ .env وحُط بياناتك
# ملف .env متجاهَل في git ومش هيترفع — متحطّش الباسورد في أي ملف تاني

WP_SITE_URL=https://your-site.com
WP_USERNAME=your-username

# Application Password من: لوحة التحكم → Users → Profile → Application Passwords
# المسافات مش مهمة، السكربت بيشيلها
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# اختياري — لو المقالات في مكان تاني
# WP_CONTENT_DIR=./content
