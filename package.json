{
  "name": "mkss-support",
  "version": "1.0.0",
  "private": true,
  "description": "نظام دعم العملاء ومراقبة المواقع — صفر اعتماديات خارجية",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "seed": "node --disable-warning=ExperimentalWarning seed.js",
    "reset": "rm -f data/mkss.db && node seed.js",
    "test": "rm -f data/test.db data/test.db-* && MKSS_DB=data/test.db node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {},
  "devDependencies": {}
}
